{
  "lineWidth": 120,
  "indentWidth": 2,
  "useTabs": false,
  "markdown": {
    "lineWidth": 80
  },
  "json": {
    "lineWidth": 120
  },
  "includes": ["**/*.md", "**/*.json"],
  "excludes": ["**/node_modules", "**/vendor", "**/.git"],
  "plugins": [
    "https://plugins.dprint.dev/markdown-0.17.8.wasm",
    "https://plugins.dprint.dev/json-0.19.4.wasm"
  ]
}
