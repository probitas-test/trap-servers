[private]
default:
    @just --list

# Run linter
lint:
    golangci-lint run ./...

# Run tests
test:
    go test -v ./...

# Build binary
build:
    go build -o trap-webhook .

# Format code
fmt:
    go fmt ./...
    goimports -w .

# Clean build artifacts
clean:
    rm -f trap-webhook

# Tidy dependencies
tidy:
    go mod tidy

# Run the server locally
run:
    go run .

# Check formatting without changing files
fmt-check:
    @out="$(gofmt -l . && goimports -l .)" || exit 1; if [ -n "$out" ]; then echo "Not formatted (run \`just fmt\`):"; echo "$out"; exit 1; fi

# Everything CI runs for this server
ci: lint fmt-check test build
